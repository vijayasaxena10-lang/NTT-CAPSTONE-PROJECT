CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    Not(in=instruction[15], out=isA);
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aluToA);
    And(a=instruction[15], b=instruction[5], out=loadAFromC);
    Or(a=isA, b=loadAFromC, out=loadA);
    ARegister(in=aluToA, load=loadA, out=aOut, out[0..14]=addressM);
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aluY);
    ALU(x=dOut, y=aluY, zx=instruction[11], nx=instruction[10], zy=instruction[9], ny=instruction[8], f=instruction[7], no=instruction[6], out=aluOut, out=outM, zr=zr, ng=ng);
    And(a=instruction[15], b=instruction[3], out=writeM);
    Not(in=ng, out=notNg);
    Not(in=zr, out=notZr);
    And(a=notNg, b=notZr, out=positive);
    And(a=instruction[0], b=positive, out=jgt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[2], b=ng, out=jlt);
    Or(a=jgt, b=jeq, out=jumpPartial);
    Or(a=jumpPartial, b=jlt, out=jumpRequested);
    And(a=instruction[15], b=jumpRequested, out=loadPC);
    PC(in=aOut, load=loadPC, inc=true, reset=reset, out[0..14]=pc);
}
